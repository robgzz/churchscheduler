  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "job": "node src/jobs/scheduler.js",
    "test": "node scripts/sync-anthology.js && node --test",
    "lint:syntax": "node --check src/server.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check && find public/assets -name '*.js' -print0 | xargs -0 -n1 node --check",
    "ios:add": "npx cap add ios",
